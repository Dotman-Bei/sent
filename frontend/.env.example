# ---------------------------------------------------------------------------
# Frontend build-time configuration.
#
# EVERY var here is prefixed VITE_, which means Vite INLINES it into the
# JavaScript bundle shipped to browsers. All of it is PUBLIC.
# Never put PRIVATE_KEY, a mnemonic, or any secret in this file or in Vercel.
# There is no server side here — the app reads the chain directly.
# ---------------------------------------------------------------------------

# --- BOT Chain Testnet (current deployment) --------------------------------
VITE_CHAIN_ID=968
VITE_RPC_URL=https://rpc.bohr.life
VITE_EXPLORER_URL=https://scan.bohr.life

# --- BOT Chain Mainnet -----------------------------------------------------
# VITE_CHAIN_ID=677
# VITE_RPC_URL=https://rpc.botchain.ai
# VITE_EXPLORER_URL=https://scan.botchain.ai

# --- Contract addresses (optional) -----------------------------------------
# Defaults come from src/config/addresses.ts, regenerated by scripts/deploy.ts.
# Set these only to point a hosted build at a different deployment without
# changing the committed code. These are public on-chain addresses.
# VITE_BUDGET_VAULT_ADDRESS=0x3822E863D851DfC9CD0cfaF687195928461f72e4
# VITE_AGENT_REGISTRY_ADDRESS=0x521C15E3cF59a062204279EC715e81859d95B5AF
# VITE_CIRCUIT_BREAKER_ADDRESS=0x959A3B3d2856288E044136dAF3e7823f8dD7A449
